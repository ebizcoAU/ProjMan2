# ProjMan2 API — copy to .env and fill in. Never commit .env.
# The legacy ProjMan repo committed live credentials to a GitHub remote.
# That must not be repeated here.

NODE_ENV=development
PORT=5100
TZ=Australia/Perth

# ── Database ──────────────────────────────────────────────────
# c1projman2 is a NEW database. The legacy c1projman is not migrated.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=c1projman2

# ── JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Device-bound tokens issued by pairing confirm
PAIRED_JWT_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────────────────────
# The Next.js office console. Comma-separated.
CORS_ORIGINS=http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# ── Email (recovery codes) ────────────────────────────────────
# When EMAIL_ENABLED is false the code is logged to the console in dev only.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=ProjMan2 <noreply@ebizco.com.au>

# ── Password policy ───────────────────────────────────────────
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MS=900000

# ── ABN validation ────────────────────────────────────────────
# Checksum validation always runs. ABR lookup runs only if a GUID is set;
# register with the ABR Web Services to obtain one. Without it, ABNs are
# stored with abn_validated = 'checksum'.
ABR_GUID=

# ── OAuth sign-in (Google / Microsoft / Facebook only) ────────
# The app obtains a provider token on the device and posts it to
# /auth/oauth/:provider; the server verifies it against the provider.
#
# Dev shortcut: with OAUTH_DEV_BYPASS=true (dev only) the server accepts a token
# "dev:<provider>:<email>:<name>" so the login + onboarding UI can be built before
# the real OAuth apps are registered. NEVER set this in production.
OAUTH_DEV_BYPASS=true

# Google: one client id per platform (iOS / Android / web), comma-separated.
GOOGLE_CLIENT_IDS=
# Microsoft (Azure AD app registration, multi-tenant):
MICROSOFT_CLIENT_ID=
# Facebook (Meta app):
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── SMS mobile verification (+61) ─────────────────────────────
# Verifies an Australian mobile during onboarding. Console in dev (code logs to the
# terminal). Given the AU data-residency rule, prefer an AU-resident sender in prod.
SMS_ENABLED=false
SMS_PROVIDER=console          # console | messagemedia | twilio | clicksend
SMS_FROM=ProjMan2
# MessageMedia (Australian):
MESSAGEMEDIA_API_KEY=
MESSAGEMEDIA_API_SECRET=
# Twilio:
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# ClickSend — https://developers.clicksend.com/docs#authentication (Basic auth,
# username + API key, not your account password):
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=

# ── AI inference (server-side only) ──
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_EXTRACTOR_MODEL=gpt-4o
AI_IVR_TRAINER_MODEL=gpt-4o
AI_REVIEWER_MODEL=gpt-4o
AI_CGPA_COMPILER_MODEL=gpt-4o
AI_REVIEWER_THRESHOLD=0.72
AI_IVR_CONFIDENCE_THRESHOLD=0.75
