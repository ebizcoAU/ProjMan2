# ProjMan2 API — DEVELOPMENT template. Copy to .env.development and fill in.
# Never commit .env.development itself — only this .example file is tracked.
# (`.env.example` still exists too, kept as a plain alias of this file for
# anyone not yet on the dev/production split — same values, same posture.)

NODE_ENV=development
PORT=5100
TZ=Australia/Perth

# ── Database — local MySQL for dev, always ───────────────────────────────────
# c1projman2 is a NEW database. The legacy c1projman is not migrated.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=c1projman2

# ── JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PAIRED_JWT_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# ── Email (recovery codes) ────────────────────────────────────
# When EMAIL_ENABLED is false the code is logged to the console instead.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=ProjMan2 <noreply@ebizco.com.au>

# ── Password policy ───────────────────────────────────────────
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MS=900000

# ── ABN validation ────────────────────────────────────────────
ABR_GUID=

# ── OAuth sign-in (Google / Microsoft / Facebook only) ────────
# dev-only shortcut — NEVER true in .env.production.
OAUTH_DEV_BYPASS=true
GOOGLE_CLIENT_IDS=
MICROSOFT_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── SMS mobile verification (+61) ─────────────────────────────
SMS_ENABLED=false
SMS_PROVIDER=console          # console | messagemedia | twilio | clicksend
SMS_FROM=ProjMan2
MESSAGEMEDIA_API_KEY=
MESSAGEMEDIA_API_SECRET=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=

# ── AI inference (server-side only) ──
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_EXTRACTOR_MODEL=gpt-4o
AI_IVR_TRAINER_MODEL=gpt-4o
AI_REVIEWER_MODEL=gpt-4o
AI_CGPA_COMPILER_MODEL=gpt-4o
AI_REVIEWER_THRESHOLD=0.72
AI_IVR_CONFIDENCE_THRESHOLD=0.75

# ── MQTT signalling (2026-09-03) ──────────────────────────────
# Real-time "something changed, go pull" nudges over the top of the existing
# poll-based sync — never a data-transport channel. See src/mqtt/client.js.
# ⚠ This dev machine may already run a SHARED broker other live projects
# depend on (real hardware, in at least one case) — connect to whatever's
# already there, never start/kill a separate instance without checking first.
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=projman2-server
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=projman2
