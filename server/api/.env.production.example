# ProjMan2 API — PRODUCTION template. Copy to .env.production and fill in.
# Never commit .env.production itself — only this .example file is tracked.
#
# ⚠ ProjMan2 has no deployed production environment yet (2026-09-03) — every
# value below is a placeholder/shape, not a confirmed live setting. Fill in
# for real once a production host/DB/domain is actually provisioned.

NODE_ENV=production
PORT=5100
TZ=Australia/Perth

# ── Database — PLACEHOLDER, not yet provisioned. See server/shared/constants.js. ──
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=c1projman2

# ── JWT — generate fresh secrets for production, never reuse dev's ────────────
# openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PAIRED_JWT_EXPIRES_IN=30d

# ── CORS — the real production Portal/Dashboard/VeriTrade origins ────────────
CORS_ORIGINS=

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# ── Email (recovery codes) — must be enabled in production ───────────────────
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=ProjMan2 <noreply@ebizco.com.au>

# ── Password policy ───────────────────────────────────────────
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MS=900000

# ── ABN validation ────────────────────────────────────────────
ABR_GUID=

# ── OAuth sign-in — NEVER true in production ──────────────────
OAUTH_DEV_BYPASS=false
GOOGLE_CLIENT_IDS=
MICROSOFT_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── SMS mobile verification (+61) — must be a real provider in production ────
SMS_ENABLED=true
SMS_PROVIDER=clicksend        # console | messagemedia | twilio | clicksend
SMS_FROM=ProjMan2
MESSAGEMEDIA_API_KEY=
MESSAGEMEDIA_API_SECRET=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=

# ── AI inference (server-side only) ──
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_EXTRACTOR_MODEL=gpt-4o
AI_IVR_TRAINER_MODEL=gpt-4o
AI_REVIEWER_MODEL=gpt-4o
AI_CGPA_COMPILER_MODEL=gpt-4o
AI_REVIEWER_THRESHOLD=0.72
AI_IVR_CONFIDENCE_THRESHOLD=0.75

# ── MQTT signalling ────────────────────────────────────────────
# REAL — eBizco's own shared production broker, confirmed by the owner
# 2026-09-03: MQTTS on :8883. Own username/password — provision separately,
# do not reuse Nexus's `talkpos` or ozkit's `simlock` credentials.
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtts://mqtt.ebizco.com.au:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=projman2
