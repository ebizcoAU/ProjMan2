# ProjMan2 Portal (:4220) — env template (tracked; copy to .env and fill in).
# .env / .env*.local are gitignored; this template is not.

# Server-side proxy target for /api/* rewrites (next.config.js). Dev default = the
# owner's API on :4100. Point at your API instance in prod, or :4199 for a throwaway.
API_URL=http://localhost:4100

# Client-side API base. Optional — the /api/* proxy above makes calls same-origin,
# so this can be left empty in dev. Set to the public API origin in prod if needed.
NEXT_PUBLIC_API_URL=

# Google Identity Services web sign-in (login/page.js). REQUIRED for Portal Google
# login in prod; when empty, dev falls back to OAUTH_DEV_BYPASS. Must be one of the
# server's GOOGLE_CLIENT_IDS. Web client id (xprojman-20, Firebase projman-f4bca,
# OAuth client_type 3) — a public identifier that ships in the browser bundle, not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=336317627750-9ggol8vtikqitilsdmkp2n04qk55hivm.apps.googleusercontent.com
