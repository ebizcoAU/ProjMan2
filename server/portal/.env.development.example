# ProjMan2 Portal (:5102) — DEVELOPMENT template. Copy to .env.development and fill in.
# .env* (except *.example) are gitignored.
#
# API_URL is optional now — next.config.js falls back to server/shared/constants.js's
# API_URL default (http://localhost:5100 in dev) when this is unset. Set it only to
# override that default (e.g. pointing at a throwaway :4199 instance).
API_URL=

# Client-side API base. Optional — the /api/* proxy makes calls same-origin, so this
# can stay empty in dev.
NEXT_PUBLIC_API_URL=

# Google Identity Services web sign-in (login/page.js). When empty, dev falls back to
# OAUTH_DEV_BYPASS on the server. Must be one of the server's GOOGLE_CLIENT_IDS — a
# public identifier that ships in the browser bundle, not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=336317627750-9ggol8vtikqitilsdmkp2n04qk55hivm.apps.googleusercontent.com
