# VeriTrade (:4330) — env template (tracked; copy to .env and fill in).
# .env / .env*.local are gitignored; this template is not.

# Server-side proxy target for /api/* rewrites (next.config.js). Point at the same
# API instance Portal/App use; :4199 for a local throwaway instance during dev.
API_URL=http://localhost:4100

# Client-side API base. Optional — the /api/* proxy above makes calls same-origin.
NEXT_PUBLIC_API_URL=

# Dev-only: shows a "Dev: approve as…" panel on /login so the browser<->App login
# loop can be tested end to end before the App team ships their "Scan to sign in"
# screen (xprojman-02: it doesn't exist yet). NEVER set this in production — it lets
# the browser itself complete the approval step a phone is supposed to gate.
NEXT_PUBLIC_VERITRADE_DEV_LOGIN=true
