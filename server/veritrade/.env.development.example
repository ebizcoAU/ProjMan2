# VeriTrade (:5103) — DEVELOPMENT template. Copy to .env.development and fill in.
# .env* (except *.example) are gitignored.
#
# API_URL is optional now — next.config.js falls back to server/shared/constants.js's
# API_URL default (http://localhost:5100 in dev) when this is unset.
API_URL=

NEXT_PUBLIC_API_URL=

# Dev-only: shows a "Dev: approve as…" panel on /login. NEVER set true in production.
NEXT_PUBLIC_VERITRADE_DEV_LOGIN=true
