# ── Server ─────────────────────────────────────────────────────
# Port is fixed by package.json's start script (`next start -p 5105`), not
# read from an env var here — kept in the contiguous 51xx block (see
# server/shared/constants.js for the full service port map).
NODE_ENV=production

# ── Email (contact-form leads) ────────────────────────────────
# When EMAIL_ENABLED is false the lead is logged to the console in dev only —
# in production a disabled mailer is a hard failure (see lib/email.ts).
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=ProjMan Website <noreply@ebizco.com.au>
CONTACT_TO_EMAIL=sales@ebizco.com.au
